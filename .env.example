# Copy to .env on the server machine. Never commit .env.
# --- Web backend (backend/) ---
ADMIN_EMAILS=trainguyenchi30@gmail.com      # comma-separated; admins are defined only here
WEB_ADMIN_CONTACT_EMAIL=trainguyenchi30@gmail.com  # contact shown on locked pipelines
VIEWER_EMAILS=                               # optional pre-approved viewers
ALLOW_ANY_GOOGLE_VIEWER=true                 # verified Google accounts can view unlocked pipelines; admin revocation still applies
GOOGLE_CLIENT_ID=                            # OAuth 2.0 Web client ID (same value as frontend/config.js)
AUTH_SESSION_SECRET=                         # long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_ACCESS_TTL_SECONDS=900                  # short-lived access token (15 minutes)
AUTH_REFRESH_TTL_SECONDS=604800              # absolute session lifetime (7 days), rotated on refresh
WEB_HOST=127.0.0.1
WEB_PORT=8724                                # Cloudflare tunnel: api-crypto.nguyenchitrai.id.vn -> http://localhost:8724
CORS_ALLOW_ORIGINS=https://your-frontend-domain.example
# CORS_ALLOW_ORIGIN_REGEX=                  # leave empty; list exact owned origins above
WEB_DB_PATH=                                 # default artifacts/web/app.db
WEB_SCHEDULER_ENABLED=true                   # all 5 every 4h; unfinished first, in admin order (default: return, drawdown, win)
WEB_LOCAL_NO_AUTH=true                       # requests made on this machine (not via the tunnel) act as the admin, no login
WEB_SCHEDULE_OFFSET_MINUTES=1                 # run right after the 4h close: the trade plan must be out before minute 5
WEB_DEFAULT_EQUITY_USDT=10000
# --- Cloudflare tunnel (run_backend.ps1 starts the connector) ---
CLOUDFLARE_TUNNEL_TOKEN=                     # token of the tunnel api-crypto.nguyenchitrai.id.vn -> http://localhost:8724
